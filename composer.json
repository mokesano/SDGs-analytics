{
    "name": "sangia/chairakha",
    "description": "Publications Researcher Classification & Analytics Application with PSR-4/PSR-12 standards",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Rochmady",
            "email": "rochmady@sangia.org"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": "^8.2",
        "delight-im/auth": "^4.0",
        "guzzlehttp/guzzle": "^7.8",
        "fivefilters/readability.php": "^3.3",
        "phpoffice/phpword": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wizdam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wizdam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
